    "document_html": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Générateur de Recettes pour Aliments Spécifiques | Composez Votre Recette Idéale</title>\n    <meta name=\"description\" content=\"Créez des recettes personnalisées en fonction d\">\n    <style>\n        :root {\n            --color-primary: #FF6B6B; /* Bright Red */\n            --color-secondary: #4ECDC4; /* Teal */\n            --color-accent: #FFE66D; /* Yellow */\n            --color-text: #333;\n            --color-background: #F7FFF7; /* Light Greenish White */\n            --color-card-bg: #FFFFFF;\n            --font-headline: 'Georgia', serif;\n            --font-body: 'Arial', sans-serif;\n            --shadow-light: 0 4px 8px rgba(0,0,0,0.05);\n            --shadow-medium: 0 8px 16px rgba(0,0,0,0.1);\n        }\n\n        body {\n            font-family: var(--font-body);\n            color: var(--color-text);\n            background-color: var(--color-background);\n            margin: 0;\n            padding: 0;\n            line-height: 1.6;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n        }\n\n        .container {\n            width: 90%;\n            max-width: 1000px;\n            margin: 20px auto;\n            padding: 20px;\n        }\n\n        header {\n            background-color: var(--color-primary);\n            color: white;\n            padding: 40px 20px;\n            text-align: center;\n            border-radius: 12px;\n            margin-bottom: 30px;\n            box-shadow: var(--shadow-medium);\n        }\n\n        header h1 {\n            font-family: var(--font-headline);\n            font-size: 2.8em;\n            margin-bottom: 15px;\n            line-height: 1.1;\n        }\n\n        header p {\n            font-size: 1.2em;\n            max-width: 700px;\n            margin: 0 auto;\n        }\n\n        .section {\n            background-color: var(--color-card-bg);\n            border-radius: 12px;\n            padding: 30px;\n            margin-bottom: 30px;\n            box-shadow: var(--shadow-light);\n        }\n\n        .section h2 {\n            font-family: var(--font-headline);\n            color: var(--color-primary);\n            font-size: 2em;\n            margin-bottom: 20px;\n            text-align: center;\n        }\n\n        .form-group {\n            margin-bottom: 20px;\n        }\n\n        label {\n            display: block;\n            margin-bottom: 8px;\n            font-weight: bold;\n            color: var(--color-text);\n        }\n\n        input[type=\"text\"],\n        textarea,\n        select {\n            width: calc(100% - 20px);\n            padding: 12px;\n            border: 1px solid #ddd;\n            border-radius: 8px;\n            font-size: 1em;\n            box-sizing: border-box;\n            background-color: #fcfcfc;\n        }\n\n        textarea {\n            min-height: 100px;\n            resize: vertical;\n        }\n\n        .checkbox-group label {\n            display: inline-block;\n            margin-right: 15px;\n            font-weight: normal;\n        }\n\n        input[type=\"checkbox\"] {\n            margin-right: 5px;\n        }\n\n        button {\n            display: block;\n            width: 100%;\n            padding: 15px 25px;\n            background-color: var(--color-secondary);\n            color: white;\n            border: none;\n            border-radius: 8px;\n            font-size: 1.2em;\n            cursor: pointer;\n            transition: background-color 0.3s ease, transform 0.2s ease;\n            box-shadow: var(--shadow-light);\n        }\n\n        button:hover {\n            background-color: #3BBFBA;\n            transform: translateY(-2px);\n        }\n\n        .tool-result {\n            background-color: #e6f7f7; /* Lighter teal */\n            border-left: 5px solid var(--color-secondary);\n            padding: 25px;\n            border-radius: 8px;\n            margin-top: 30px;\n            min-height: 150px;\n        }\n\n        .tool-result h3 {\n            color: var(--color-secondary);\n            font-family: var(--font-headline);\n            margin-top: 0;\n            font-size: 1.6em;\n            margin-bottom: 15px;\n        }\n\n        .result-group {\n            margin-bottom: 20px;\n        }\n        .result-group h4 {\n            color: var(--color-primary);\n            font-size: 1.2em;\n            margin-bottom: 10px;\n            border-bottom: 1px solid var(--color-accent);\n            padding-bottom: 5px;\n        }\n        .result-group ul {\n            list-style: none;\n            padding: 0;\n            margin: 0;\n        }\n        .result-group li {\n            background-color: var(--color-card-bg);\n            border: 1px solid #eee;\n            margin-bottom: 8px;\n            padding: 10px 15px;\n            border-radius: 6px;\n            transition: background-color 0.2s ease;\n        }\n        .result-group li:hover {\n            background-color: #f0f8f8;\n        }\n\n        .seo-section {\n            padding: 40px 20px;\n            background-color: #f0f0f0;\n            border-radius: 12px;\n            margin-top: 50px;\n            text-align: center;\n        }\n\n        .seo-section h2 {\n            color: var(--color-text);\n            font-family: var(--font-headline);\n            margin-bottom: 25px;\n            font-size: 2.2em;\n        }\n\n        .seo-section p {\n            max-width: 800px;\n            margin: 0 auto 15px auto;\n            font-size: 1.1em;\n            color: #555;\n        }\n\n        .seo-section ul {\n            list-style: none;\n            padding: 0;\n            margin-top: 20px;\n            display: flex;\n            flex-wrap: wrap;\n            justify-content: center;\n            gap: 15px;\n        }\n\n        .seo-section li {\n            background-color: var(--color-card-bg);\n            border: 1px solid #ddd;\n            border-radius: 8px;\n            padding: 10px 15px;\n            font-size: 0.95em;\n            color: var(--color-primary);\n            font-weight: bold;\n            box-shadow: var(--shadow-light);\n        }\n\n        footer {\n            margin-top: 50px;\n            padding: 20px;\n            text-align: center;\n            color: #777;\n            font-size: 0.9em;\n            background-color: var(--color-background);\n        }\n    </style>\n    <meta name=\"robots\" content=\"index, follow\">\n    <link rel=\"canonical\" href=\"https://generateur-de-recettes-pour-aliments-specifiques-2.onrender.com\">\n    <meta property=\"og:title\" content=\"Générateur de Recettes pour Aliments Spécifiques\">\n    <meta property=\"og:description\" content=\"Créez des recettes personnalisées en fonction d\">\n    <meta property=\"og:url\" content=\"https://generateur-de-recettes-pour-aliments-specifiques-2.onrender.com\">\n    <meta property=\"og:type\" content=\"website\">\n    <script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"WebApplication\", \"name\": \"Générateur de Recettes pour Aliments Spécifiques\", \"description\": \"Créez des recettes personnalisées en fonction d\", \"url\": \"https://generateur-de-recettes-pour-aliments-specifiques-2.onrender.com\", \"applicationCategory\": \"UtilityApplication\", \"operatingSystem\": \"Web Browser\"}</script>\n</head>\n<body data-site-slug=\"generateur-de-recettes-pour-aliments-specifiques-2\" data-runtime-mode=\"document_generator\">\n    <header>\n        <div class=\"container\">\n            <h1>Cuisinez Malin : Votre Générateur de Recettes sur Mesure !</h1>\n            <p>Dites adieu au casse-tête des repas ! Créez des recettes délicieuses et adaptées à vos besoins : allergies, régimes spécifiques (vegan, keto, sans gluten...) et même les ingrédients que vous avez déjà sous la main. Moins de gaspillage, plus de plaisir en cuisine !</p>\n        </div>\n    </header>\n\n    <div class=\"container\">\n        <section class=\"section\">\n            <h2>Composez Votre Recette Idéale</h2>\n            <p>Remplissez les champs ci-dessous pour nous aider à concocter la suggestion parfaite pour vous.</p>\n            <form id=\"tool-form\">\n                <div class=\"form-group\">\n                    <label for=\"ingredients\">Ingrédients que j'ai (séparés par des virgules) :</label>\n                    <textarea id=\"ingredients\" placeholder=\"Ex: poulet, riz, brocoli, ail, sauce soja\"></textarea>\n                </div>\n\n                <div class=\"form-group\">\n                    <label for=\"allergies\">Allergies ou Intolérances (séparées par des virgules) :</label>\n                    <input type=\"text\" id=\"allergies\" placeholder=\"Ex: arachides, lactose, gluten\">\n                </div>\n\n                <div class=\"form-group\">\n                    <label>Régimes alimentaires :</label>\n                    <div class=\"checkbox-group\">\n                        <label><input type=\"checkbox\" name=\"diet\" value=\"vegan\"> Végan</label>\n                        <label><input type=\"checkbox\" name=\"diet\" value=\"vegetarien\"> Végétarien</label>\n                        <label><input type=\"checkbox\" name=\"diet\" value=\"keto\"> Céto (Keto)</label>\n                        <label><input type=\"checkbox\" name=\"diet\" value=\"sans-gluten\"> Sans Gluten</label>\n                        <label><input type=\"checkbox\" name=\"diet\" value=\"sans-lactose\"> Sans Lactose</label>\n                    </div>\n                </div>\n\n                <div class=\"form-group\">\n                    <label for=\"dish-type\">Type de plat souhaité (facultatif) :</label>\n                    <select id=\"dish-type\">\n                        <option value=\"\">N'importe</option>\n                        <option value=\"plat-principal\">Plat Principal</option>\n                        <option value=\"entree\">Entrée</option>\n                        <option value=\"dessert\">Dessert</option>\n                        <option value=\"petit-dejeuner\">Petit-déjeuner</option>\n                        <option value=\"soupe\">Soupe</option>\n                        <option value=\"salade\">Salade</option>\n                    </select>\n                </div>\n\n                <button type=\"submit\" id=\"tool-submit\" data-affiliate-slot=\"recipe-generator-cta\">Générer ma Recette !</button>\n            </form>\n\n            <div id=\"tool-result\" class=\"tool-result\" style=\"display:none;\">\n                <h3 id=\"result-headline\">Votre Recette Personnalisée :</h3>\n                <div id=\"recipe-output\"></div>\n            </div>\n        </section>\n\n        <section class=\"section\">\n            <h2>Pourquoi Cuisiner avec Notre Générateur ?</h2>\n            <div style=\"display: flex; flex-wrap: wrap; gap: 20px; justify-content: center;\">\n                <div style=\"flex: 1; min-width: 280px; padding: 15px; border: 1px solid #eee; border-radius: 8px; background-color: #fdfdfd;\">\n                    <h3 style=\"color: var(--color-secondary); font-family: var(--font-headline); margin-top: 0;\">Zéro Gaspillage</h3>\n                    <p>Utilisez intelligemment vos restes et ingrédients du frigo avant qu'ils ne périment. Fini le gaspillage alimentaire !</p>\n                </div>\n                <div style=\"flex: 1; min-width: 280px; padding: 15px; border: 1px solid #eee; border-radius: 8px; background-color: #fdfdfd;\">\n                    <h3 style=\"color: var(--color-secondary); font-family: var(--font-headline); margin-top: 0;\">Adapté à Tous</h3>\n                    <p>Que vous soyez vegan, intolérant au gluten ou que vous suiviez un régime spécifique, nos recettes sont faites pour vous.</p>\n                </div>\n                <div style=\"flex: 1; min-width: 280px; padding: 15px; border: 1px solid #eee; border-radius: 8px; background-color: #fdfdfd;\">\n                    <h3 style=\"color: var(--color-secondary); font-family: var(--font-headline); margin-top: 0;\">Inspiration Quotidienne</h3>\n                    <p>Découvrez de nouvelles saveurs et des idées originales pour pimenter vos repas, sans effort ni stress.</p>\n                </div>\n            </div>\n        </section>\n    </div>\n\n    <section class=\"seo-section\">\n        <h2>Trouvez l'inspiration culinaire sur mesure avec \"Cuisinez Malin\"</h2>\n        <p>Vous recherchez des <a href=\"#\" style=\"color: var(--color-primary); text-decoration: none;\">recettes faciles</a>, des <a href=\"#\" style=\"color: var(--color-primary); text-decoration: none;\">idées de repas sains</a> ou un moyen d'éviter le <a href=\"#\" style=\"color: var(--color-primary); text-decoration: none;\">gaspillage alimentaire</a> ? Notre générateur de recettes intelligent est la solution. Il vous aide à transformer vos <a href=\"#\" style=\"color: var(--color-primary); text-decoration: none;\">ingrédients du frigo</a> en délices adaptés à vos <a href=\"#\" style=\"color: var(--color-primary); text-decoration: none;\">allergies alimentaires</a> et à votre <a href=\"#\" style=\"color: var(--color-primary); text-decoration: none;\">régime spécifique</a>. Que vous soyez à la recherche de <a href=\"#\" style=\"color: var(--color-primary); text-decoration: none;\">recettes vegan sans gluten</a>, de <a href=\"#\" style=\"color: var(--color-primary); text-decoration: none;\">plats céto rapides</a> ou de <a href=\"#\" style=\"color: var(--color-primary); text-decoration: none;\">menus végétariens équilibrés</a>, notre outil est fait pour vous. Cuisiner devient un jeu d'enfant, même avec des contraintes !</p>\n        <ul>\n            <li>Recettes adaptées</li>\n            <li>Cuisine anti-gaspi</li>\n            <li>Idées repas personnalisées</li>\n            <li>Plats sans allergènes</li>\n            <li>Régime végétarien</li>\n            <li>Recettes sans gluten</li>\n            <li>Cuisine Keto France</li>\n            <li>Menus simples et rapides</li>\n        </ul>\n    </section>\n\n    <footer>\n        <p>&copy; 2023 Cuisinez Malin. Tous droits réservés.</p>\n    </footer>\n\n    <script>\n        document.getElementById('tool-form').addEventListener('submit', function(event) {\n            event.preventDefault();\n\n            const ingredientsInput = document.getElementById('ingredients').value.toLowerCase().split(',').map(s => s.trim()).filter(s => s.length > 0);\n            const allergiesInput = document.getElementById('allergies').value.toLowerCase().split(',').map(s => s.trim()).filter(s => s.length > 0);\n            const selectedDiets = Array.from(document.querySelectorAll('input[name=\"diet\"]:checked')).map(cb => cb.value);\n            const dishType = document.getElementById('dish-type').value;\n\n            const recipes = generateRecipes(ingredientsInput, allergiesInput, selectedDiets, dishType);\n            displayRecipes(recipes);\n        });\n\n        function generateRecipes(ingredients, allergies, diets, dishType) {\n            let baseRecipes = [\n                {\n                    name: \"Curry de Légumes Express\",\n                    description: \"Un curry végétarien riche en saveurs, idéal pour un repas rapide.\",\n                    ingredients: [\"légumes de saison\", \"lait de coco\", \"pâte de curry\", \"riz\"],\n                    diet: [\"vegetarien\", \"vegan\", \"sans-gluten\", \"sans-lactose\"],\n                    allergens: []\n                },\n                {\n                    name: \"Poulet Rôti aux Herbes de Provence\",\n                    description: \"Un classique revisité pour les amateurs de viande.\",\n                    ingredients: [\"poulet\", \"pommes de terre\", \"herbes de provence\", \"ail\"],\n                    diet: [],\n                    allergens: []\n                },\n                {\n                    name: \"Salade Quinoa et Avocat\",\n                    description: \"Une salade fraîche et nutritive, parfaite pour un déjeuner léger.\",\n                    ingredients: [\"quinoa\", \"avocat\", \"tomate\", \"concombre\", \"citron\"],\n                    diet: [\"vegetarien\", \"vegan\", \"sans-gluten\", \"sans-lactose\"],\n                    allergens: []\n                },\n                {\n                    name: \"Pâtes Carbonara Façon Healthy\",\n                    description: \"Une version plus légère de la carbonara, avec des légumes.\",\n                    ingredients: [\"pâtes\", \"œufs\", \"lardons de dinde\", \"petits pois\"],\n                    diet: [],\n                    allergens: [\"gluten\", \"lactose\"] // Can be adapted\n                },\n                {\n                    name: \"Brochettes de Crevettes Marinées\",\n                    description: \"Des brochettes savoureuses pour une grillade estivale.\",\n                    ingredients: [\"crevettes\", \"poivrons\", \"oignons\", \"sauce soja\", \"miel\"],\n                    diet: [\"sans-gluten\"], // if soy sauce is gluten-free\n                    allergens: [\"soja\"]\n                },\n                {\n                    name: \"Omelette Fromagère aux Champignons\",\n                    description: \"Un plat simple et réconfortant pour toute occasion.\",\n                    ingredients: [\"œufs\", \"champignons\", \"fromage\", \"oignon\"],\n                    diet: [\"vegetarien\"],\n                    allergens: [\"lactose\"]\n                },\n                {\n                    name: \"Soupe de Lentilles Corail au Curcuma\",\n                    description: \"Une soupe épicée et réchauffante, pleine de fibres.\",\n                    ingredients: [\"lentilles corail\", \"carottes\", \"oignon\", \"curcuma\", \"bouillon de légumes\"],\n                    diet: [\"vegetarien\", \"vegan\", \"sans-gluten\", \"sans-lactose\"],\n                    allergens: []\n                },\n                 {\n                    name: \"Bowl de Buddha Végétarien\",\n                    description: \"Un bol complet et équilibré avec des protéines végétales.\",\n                    ingredients: [\"riz\", \"pois chiches\", \"patate douce\", \"épinards\", \"sauce tahini\"],\n                    diet: [\"vegetarien\", \"vegan\", \"sans-gluten\", \"sans-lactose\"],\n                    allergens: [\"sésame\"]\n                },\n                 {\n                    name: \"Tofu Scrambled aux Épices\",\n                    description: \"Une alternative végane aux œufs brouillés pour le petit-déjeuner.\",\n                    ingredients: [\"tofu ferme\", \"curcuma\", \"oignon\", \"levure maltée\", \"épinards\"],\n                    diet: [\"vegan\", \"vegetarien\", \"sans-gluten\", \"sans-lactose\"],\n                    allergens: [\"soja\"]\n                },\n                {\n                    name: \"Steak de Chou-fleur Rôti\",\n                    description: \"Une option végétarienne surprenante et délicieuse, riche en saveurs.\",\n                    ingredients: [\"chou-fleur\", \"huile d'olive\", \"paprika\", \"cumin\", \"ail\"],\n                    diet: [\"vegan\", \"vegetarien\", \"sans-gluten\", \"sans-lactose\"],\n                    allergens: []\n                }\n            ];\n\n            let suggestedRecipes = [];\n\n            // Filter by ingredients first (must contain at least 2 user-provided ingredients OR all if user provided 2 or less)\n            let ingredientMatchedRecipes = baseRecipes.filter(recipe => {\n                if (ingredients.length === 0) return true; // If no ingredients provided, all recipes are candidates\n                const matchingIngredients = recipe.ingredients.filter(ingredient => ingredients.includes(ingredient));\n                return matchingIngredients.length >= Math.min(2, ingredients.length);\n            });\n\n            // Then filter by allergies\n            let allergyFilteredRecipes = ingredientMatchedRecipes.filter(recipe => {\n                return !allergies.some(allergy => recipe.allergens.includes(allergy));\n            });\n\n            // Then filter by diets\n            let dietFilteredRecipes = allergyFilteredRecipes.filter(recipe => {\n                if (diets.length === 0) return true; // If no diet selected, all recipes are candidates\n                return diets.every(diet => recipe.diet.includes(diet));\n            });\n\n            // Finally, filter by dish type if specified\n            if (dishType && dishType !== \"\") {\n                dietFilteredRecipes = dietFilteredRecipes.filter(recipe => {\n                    // This is a simple mapping, extend if necessary\n                    const recipeDishTypeMap = {\n                        \"Curry de Légumes Express\": \"plat-principal\",\n                        \"Poulet Rôti aux Herbes de Provence\": \"plat-principal\",\n                        \"Salade Quinoa et Avocat\": \"salade\",\n                        \"Pâtes Carbonara Façon Healthy\": \"plat-principal\",\n                        \"Brochettes de Crevettes Marinées\": \"plat-principal\",\n                        \"Omelette Fromagère aux Champignons\": \"petit-dejeuner\",\n                        \"Soupe de Lentilles Corail au Curcuma\": \"soupe\",\n                        \"Bowl de Buddha Végétarien\": \"plat-principal\",\n                        \"Tofu Scrambled aux Épices\": \"petit-dejeuner\",\n                        \"Steak de Chou-fleur Rôti\": \"plat-principal\"\n                    };\n                    return recipeDishTypeMap[recipe.name] === dishType;\n                });\n            }\n\n            // Shuffle and pick top 3 for variety\n            suggestedRecipes = dietFilteredRecipes.sort(() => 0.5 - Math.random()).slice(0, 3);\n\n            if (suggestedRecipes.length === 0) {\n                 return [{ name: \"Aucune recette trouvée\", description: \"Désolé, nous n'avons pas pu trouver de recette correspondant à tous vos critères. Essayez d'élargir vos options ou de fournir plus d'ingrédients !\", ingredients: [], diet: [], allergens: [] }];\n            }\n\n            return suggestedRecipes;\n        }\n\n\n        function displayRecipes(recipes) {\n            const resultDiv = document.getElementById('tool-result');\n            const recipeOutput = document.getElementById('recipe-output');\n            recipeOutput.innerHTML = '';\n\n            if (recipes.length > 0) {\n                recipes.forEach(recipe => {\n                    const recipeCard = document.createElement('div');\n                    recipeCard.classList.add('result-group');\n                    recipeCard.innerHTML = `\n                        <h4>${recipe.name}</h4>\n                        <p>${recipe.description}</p>\n                        <h5>Ingrédients clés suggérés :</h5>\n                        <ul>\n                            ${recipe.ingredients.map(ing => `<li>${ing.charAt(0).toUpperCase() + ing.slice(1)}</li>`).join('')}\n                        </ul>\n                        ${recipe.diet.length > 0 ? `<h5>Régimes compatibles :</h5><ul>${recipe.diet.map(d => `<li>${d.charAt(0).toUpperCase() + d.slice(1).replace('-', ' ')}</li>`).join('')}</ul>` : ''}\n                        ${recipe.allergens.length > 0 ? `<h5>Allergènes potentiels :</h5><ul>${recipe.allergens.map(a => `<li>${a.charAt(0).toUpperCase() + a.slice(1)}</li>`).join('')}</ul>` : ''}\n                    `;\n                    recipeOutput.appendChild(recipeCard);\n                });\n            } else {\n                recipeOutput.innerHTML = '<p>Désolé, aucune recette ne correspond à vos critères. Essayez de modifier vos sélections !</p>';\n            }\n\n            resultDiv.style.display = 'block';\n        }\n    </script>\n<div id=\"qa-smoke-result\" hidden></div>\n<script id=\"farmbuilder-affiliate-helper\">\n(function () {\n  window.__UTILITY_AFFILIATE_MAP = window.__UTILITY_AFFILIATE_MAP || {};\n  document.addEventListener(\"click\", function (event) {\n    const target = event.target.closest(\"[data-affiliate-slot]\");\n    if (!target) return;\n    const slot = target.getAttribute(\"data-affiliate-slot\");\n    const href = window.__UTILITY_AFFILIATE_MAP[slot];\n    if (!href) return;\n    if (target.tagName && target.tagName.toLowerCase() === \"a\") {\n      target.setAttribute(\"href\", href);\n      target.setAttribute(\"rel\", \"nofollow sponsored noopener noreferrer\");\n      return;\n    }\n    event.preventDefault();\n    window.open(href, \"_blank\", \"noopener\");\n  }, true);\n})();\n</script>\n<script id=\"farmbuilder-functional-qa\">\n(function () {\n  function marker() {\n    let node = document.getElementById(\"qa-smoke-result\");\n    if (node) return node;\n    node = document.createElement(\"div\");\n    node.id = \"qa-smoke-result\";\n    node.hidden = true;\n    document.body.appendChild(node);\n    return node;\n  }\n\n  let qaFinished = false;\n  let qaWatchdog = null;\n\n  function normalize(text) {\n    return String(text || \"\").replace(/\\s+/g, \" \").trim();\n  }\n\n  function findForm() {\n    return document.getElementById(\"tool-form\") || document.querySelector(\"form\");\n  }\n\n  function findResult() {\n    return (\n      document.getElementById(\"tool-result\") ||\n      document.querySelector(\"[data-result]\") ||\n      document.querySelector(\".tool-result, .result-card, .result, .results, .output, .preview, .diagnostic, .analysis\")\n    );\n  }\n\n  function primaryAction(form) {\n    if (!form) return null;\n    return (\n      document.getElementById(\"tool-submit\") ||\n      form.querySelector(\"#tool-submit\") ||\n      form.querySelector(\"[data-primary-action]\") ||\n      form.querySelector(\"button[type=submit]\") ||\n      form.querySelector(\"button\") ||\n      form.querySelector(\"input[type=submit]\")\n    );\n  }\n\n  function resultSignature(node) {\n    if (!node) return \"\";\n    const text = normalize(node.textContent);\n    const html = normalize(node.innerHTML).slice(0, 600);\n    return `${text}||${html}`;\n  }\n\n  function resultHeadline(node) {\n    if (!node) return \"\";\n    const heading = node.querySelector(\"h1, h2, h3, strong, b\");\n    return normalize(heading ? heading.textContent : \"\");\n  }\n\n  function sampleText(field) {\n    const key = `${field.id || \"\"} ${field.name || \"\"} ${field.placeholder || \"\"}`.toLowerCase();\n    if (/email/.test(key)) return \"bonjour@example.com\";\n    if (/url|site|website|lien/.test(key)) return \"https://example.com/offre-solaire\";\n    if (/phone|tel|mobile/.test(key)) return \"0612345678\";\n    if (/ville|city|localisation|location|region|departement|postal/.test(key)) return \"Paris\";\n    if (/orientation/.test(key)) return \"sud\";\n    if (/keyword|theme|topic|sujet|subject/.test(key)) return \"energie solaire domestique\";\n    if (/titre|title/.test(key)) return \"Simulateur solaire maison\";\n    if (/nom|name|project/.test(key)) return \"Projet Horizon\";\n    if (/description|notes|content|message/.test(key)) return \"Maison individuelle exposee sud avec toiture exploitable.\";\n    return field.placeholder || \"France\";\n  }\n\n  function sampleNumber(field) {\n    const key = `${field.id || \"\"} ${field.name || \"\"}`.toLowerCase();\n    if (/inclinaison|angle|slope/.test(key)) return \"30\";\n    if (/surface|size|m2|sqm/.test(key)) return \"28\";\n    if (/annee|year/.test(key)) return \"2024\";\n    if (/prix|price|budget|cost|amount|montant/.test(key)) return \"12000\";\n    const min = Number(field.min || \"\");\n    const max = Number(field.max || \"\");\n    if (Number.isFinite(min) && Number.isFinite(max) && max >= min) {\n      return String(Math.min(max, Math.max(min, min + Math.round((max - min) * 0.35))));\n    }\n    if (Number.isFinite(min)) return String(Math.max(min, 12));\n    if (Number.isFinite(max)) return String(Math.min(max, 12));\n    return field.value || \"12\";\n  }\n\n  function applySample(field) {\n    const tag = (field.tagName || \"\").toLowerCase();\n    const type = (field.type || \"\").toLowerCase();\n    if (field.disabled) return;\n    if (type === \"hidden\" || type === \"submit\" || type === \"button\" || type === \"reset\" || type === \"image\" || type === \"file\") {\n      return;\n    }\n    if (tag === \"select\") {\n      const option = Array.from(field.options || []).find((item) => item.value && !item.disabled) || field.options[0];\n      if (option) field.value = option.value;\n      return;\n    }\n    if (type === \"checkbox\") {\n      field.checked = true;\n      return;\n    }\n    if (type === \"radio\") {\n      field.checked = true;\n      return;\n    }\n    if (type === \"date\") {\n      field.value = \"2026-03-01\";\n      return;\n    }\n    if (type === \"email\") {\n      field.value = \"bonjour@example.com\";\n      return;\n    }\n    if (type === \"url\") {\n      field.value = \"https://example.com/offre-solaire\";\n      return;\n    }\n    if (type === \"tel\") {\n      field.value = \"0612345678\";\n      return;\n    }\n    if (type === \"color\") {\n      field.value = \"#2f855a\";\n      return;\n    }\n    if (type === \"number\" || type === \"range\") {\n      field.value = sampleNumber(field);\n      return;\n    }\n    field.value = sampleText(field);\n  }\n\n  function stamp(status, detail, headline, primary) {\n    if (qaFinished) return;\n    qaFinished = true;\n    if (qaWatchdog) {\n      window.clearTimeout(qaWatchdog);\n      qaWatchdog = null;\n    }\n    const node = marker();\n    node.dataset.status = status;\n    node.dataset.mode = \"native-form\";\n    node.dataset.detail = detail || \"\";\n    node.dataset.headline = headline || \"\";\n    node.dataset.primary = primary || \"\";\n    node.dataset.viewport = window.innerWidth <= 640 ? \"mobile\" : \"desktop\";\n    window.setTimeout(function () {\n      try {\n        window.stop();\n      } catch (_error) {}\n    }, 0);\n  }\n\n  function installModalGuards() {\n    const noop = function () {};\n    const approve = function () { return true; };\n    const empty = function () { return \"\"; };\n    try { window.alert = noop; } catch (_error) {}\n    try { window.confirm = approve; } catch (_error) {}\n    try { window.prompt = empty; } catch (_error) {}\n  }\n\n  function triggerAction(form, action) {\n    try {\n      if (typeof form.requestSubmit === \"function\") {\n        form.requestSubmit(action || undefined);\n        return;\n      }\n    } catch (_error) {}\n    if (action && typeof action.click === \"function\") {\n      action.click();\n      return;\n    }\n    form.dispatchEvent(new Event(\"submit\", { bubbles: true, cancelable: true }));\n  }\n\n  function inspectResult(before, attemptsLeft) {\n    const result = findResult();\n    if (!result) {\n      stamp(\"fail\", \"La zone de resultat est introuvable.\", \"\");\n      return;\n    }\n    const after = resultSignature(result);\n    const text = normalize(result.textContent);\n    if (after && after !== before && text.length >= 24) {\n      const primary = result.querySelector(\"a[href], button[data-href], [data-primary-url]\") || document.querySelector(\"#tool-result a[href]\");\n      stamp(\"pass\", \"Le formulaire natif a mis a jour la zone de resultat.\", resultHeadline(result), primary ? (primary.getAttribute(\"href\") || primary.getAttribute(\"data-primary-url\") || \"\") : \"\");\n      return;\n    }\n    if (attemptsLeft > 0) {\n      window.setTimeout(function () {\n        inspectResult(before, attemptsLeft - 1);\n      }, 250);\n      return;\n    }\n    stamp(\"fail\", \"La zone de resultat n'a pas renvoye de contenu exploitable.\", resultHeadline(result));\n  }\n\n  function runSmoke() {\n    const params = new URLSearchParams(window.location.search);\n    if (params.get(\"__qa\") !== \"functional\") return;\n    qaWatchdog = window.setTimeout(function () {\n      stamp(\"fail\", \"QA smoke timed out before the page reported a usable result.\", \"\");\n    }, 7000);\n    const form = findForm();\n    if (!form) {\n      stamp(\"fail\", \"Le formulaire principal est introuvable.\", \"\");\n      return;\n    }\n    const result = findResult();\n    const before = resultSignature(result);\n    installModalGuards();\n    try {\n      form.querySelectorAll(\"input, select, textarea\").forEach(applySample);\n    } catch (error) {\n      stamp(\"fail\", error && error.message ? `QA smoke sample failed: ${error.message}` : \"QA smoke sample failed before submit.\", \"\");\n      return;\n    }\n    const action = primaryAction(form);\n    try {\n      triggerAction(form, action);\n    } catch (error) {\n      stamp(\"fail\", error && error.message ? `QA smoke submit failed: ${error.message}` : \"QA smoke submit failed.\", \"\");\n      return;\n    }\n    inspectResult(before, 10);\n  }\n\n  window.addEventListener(\"error\", function (event) {\n    const message = event && event.message ? event.message : \"JavaScript runtime error during QA smoke.\";\n    stamp(\"fail\", `QA smoke JS error: ${message}`, \"\");\n  }, { once: true });\n\n  window.addEventListener(\"unhandledrejection\", function (event) {\n    const reason = event && event.reason;\n    const detail = typeof reason === \"string\"\n      ? reason\n      : reason && reason.message\n        ? reason.message\n        : \"Unhandled promise rejection during QA smoke.\";\n    stamp(\"fail\", `QA smoke rejection: ${detail}`, \"\");\n  }, { once: true });\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", function () {\n      window.setTimeout(runSmoke, 60);\n    }, { once: true });\n  } else {\n    window.setTimeout(runSmoke, 60);\n  }\n})();\